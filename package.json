{
  "name": "openclaw-spectrum",
  "version": "0.1.0",
  "description": "OpenClaw channel plugin for Photon Spectrum (iMessage, Telegram, WhatsApp Business, and more)",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spacedouut/openclaw-spectrum.git"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "spectrum",
    "photon",
    "imessage",
    "telegram"
  ],
  "files": [
    "dist/",
    "src/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./setup-entry": "./dist/setup-entry.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "manifest": "npm run build && node scripts/sync-manifest.mjs",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "engines": {
    "node": ">=24.16"
  },
  "dependencies": {
    "spectrum-ts": "12.10.1",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.6"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "openclaw": "2026.9.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "openclaw": {
    "extensions": [
      "./src/index.ts"
    ],
    "runtimeExtensions": [
      "./dist/index.js"
    ],
    "setupEntry": "./src/setup-entry.ts",
    "runtimeSetupEntry": "./dist/setup-entry.js",
    "channel": {
      "id": "spectrum",
      "label": "Photon Spectrum",
      "selectionLabel": "Photon Spectrum (iMessage, Telegram, WhatsApp)",
      "detailLabel": "Spectrum",
      "docsPath": "/channels/spectrum",
      "docsLabel": "spectrum",
      "blurb": "iMessage, Telegram, and WhatsApp Business through Photon Spectrum.",
      "aliases": [
        "photon",
        "photon-spectrum"
      ],
      "markdownCapable": true,
      "setup": {
        "fields": [
          {
            "kind": "string",
            "cli": {
              "flags": "--project-id <id>",
              "description": "Spectrum Cloud project ID"
            },
            "envVars": [
              "SPECTRUM_PROJECT_ID"
            ],
            "key": "projectId"
          },
          {
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--project-secret <secret>",
              "description": "Spectrum Cloud project secret"
            },
            "envVars": [
              "SPECTRUM_PROJECT_SECRET"
            ],
            "key": "projectSecret"
          },
          {
            "kind": "string-list",
            "cli": {
              "flags": "--providers <list>",
              "description": "Comma-separated Spectrum providers (imessage, telegram, whatsapp_business, slack)"
            },
            "key": "providers"
          },
          {
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--telegram-bot-token <token>",
              "description": "Telegram bot token from @BotFather"
            },
            "envVars": [
              "SPECTRUM_TELEGRAM_BOT_TOKEN"
            ],
            "key": "telegramBotToken"
          },
          {
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--whatsapp-access-token <token>",
              "description": "WhatsApp Business Cloud API access token (self-hosted)"
            },
            "envVars": [
              "SPECTRUM_WHATSAPP_BUSINESS_ACCESS_TOKEN"
            ],
            "key": "whatsappAccessToken"
          },
          {
            "kind": "string",
            "sensitive": true,
            "cli": {
              "flags": "--whatsapp-app-secret <secret>",
              "description": "WhatsApp Business app secret for webhook signatures (self-hosted)"
            },
            "key": "whatsappAppSecret"
          },
          {
            "kind": "string",
            "cli": {
              "flags": "--whatsapp-phone-number-id <id>",
              "description": "WhatsApp Business phone number ID (self-hosted)"
            },
            "envVars": [
              "SPECTRUM_WHATSAPP_BUSINESS_PHONE_NUMBER_ID"
            ],
            "key": "whatsappPhoneNumberId"
          }
        ]
      }
    },
    "setupFeatures": {
      "configPromotion": "preserve-root"
    },
    "compat": {
      "pluginApi": ">=2026.9.6",
      "minGatewayVersion": "2026.9.6"
    },
    "build": {
      "openclawVersion": "2026.9.6",
      "pluginSdkVersion": "2026.9.6"
    }
  }
}
